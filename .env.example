# ============================================
# MemoraeAI Environment Variables
# ============================================

# --- LLM Provider ---
LLM_PROVIDER=mistral
LLM_MODEL=mistral-small-2506
EMBEDDING_MODEL=mistral-embed
EMBEDDING_DIMENSION=1024

# --- Mistral AI (default provider) ---
MISTRAL_API_KEY=your_mistral_api_key_here

# --- MongoDB ---
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=MemoraeAI
MONGODB_DATABASE=memorae_ai

# --- Neo4j ---
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=your_username
NEO4J_PASSWORD=your_password
NEO4J_DATABASE=your_database

# --- Qdrant ---
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key

# --- App Settings ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000

# --- Memory Tuning ---
DEDUP_SIMILARITY_THRESHOLD=0.90
CONFIDENCE_THRESHOLD=0.6
MIN_IMPORTANCE_SCORE=3

# --- Forgetting Parameters ---
DECAY_LAMBDA=0.05
FORGETTING_THRESHOLD=0.15
HARD_FORGET_IMPORTANCE_THRESHOLD=3
HARD_FORGET_EPISODIC_DAYS=30
HARD_FORGET_SEMANTIC_DAYS=60

# --- Retrieval ---
RETRIEVAL_TOP_K=5

# --- Context Builder ---
CONTEXT_TOKEN_BUDGET=2000
CONTEXT_CONVERSATION_TURNS=6
